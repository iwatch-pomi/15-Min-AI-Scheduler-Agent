# --- デモモード（Google/Supabaseなしで画面とAIを試す。予定はサーバーのメモリに保存）---
# DEMO_MODE=1

# --- Auth.js ---
AUTH_SECRET=            # `npx auth secret` か `openssl rand -base64 32` で生成
AUTH_GOOGLE_ID=         # GCP の OAuth クライアントID
AUTH_GOOGLE_SECRET=     # GCP の OAuth クライアントシークレット
# AUTH_TRUST_HOST=true  # Vercel 以外で `next start` するときだけ必要（Vercel・next dev では不要）

# --- Supabase（サーバー専用。ブラウザには出ない）---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- リフレッシュトークン暗号化キー（32バイトをbase64）: `openssl rand -base64 32` ---
TOKEN_ENC_KEY=

# --- Claude ---
ANTHROPIC_API_KEY=
# モデルはマイページの「AIの使い方」で決まる（節約・通常は Sonnet、強化は Opus）。ANTHROPIC_MODEL は使わない

# --- 1ユーザー1日あたりの AI の予算（米ドル。実際の費用で計算）---
# DAILY_AI_BUDGET_USD=0.5
