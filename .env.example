# --- デモモード（Google/Supabaseなしで画面とAIを試す。予定はサーバーのメモリに保存）---
# DEMO_MODE=1

# --- Auth.js ---
AUTH_SECRET=            # `npx auth secret` か `openssl rand -base64 32` で生成
AUTH_GOOGLE_ID=         # GCP の OAuth クライアントID
AUTH_GOOGLE_SECRET=     # GCP の OAuth クライアントシークレット
# AUTH_TRUST_HOST=true  # Vercel 以外で `next start` するときだけ必要（Vercel・next dev では不要）

# --- Supabase（サーバー専用。ブラウザには出ない）---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- リフレッシュトークン暗号化キー（32バイトをbase64）: `openssl rand -base64 32` ---
TOKEN_ENC_KEY=

# --- Claude ---
ANTHROPIC_API_KEY=
# モデルはマイページの「AIの使い方」で決まる（節約・通常は Haiku、強化は Sonnet、最大は Opus）。ANTHROPIC_MODEL は使わない

# --- AI の上限は、プランごとに lib/plans.ts で決める（DAILY_AI_BUDGET_USD は使わない）---
# デモモードのプラン（free / plus / standard / pro。既定は pro）
# DEMO_PLAN=free

# --- 有料プランのお支払い（Stripe）。設定のしかたは docs/stripe-setup.md ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS=      # ライト（480円/月）の価格 ID
STRIPE_PRICE_STANDARD=  # スタンダード（1,280円/月）の価格 ID
STRIPE_PRICE_PRO=       # プロ（1,480円/月）の価格 ID
